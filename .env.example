# Optional: default address shown in the Online menu. Public URL, not a secret.
# Copy to .env.local after publishing your own server, then restart Expo.
EXPO_PUBLIC_MULTIPLAYER_URL=https://serrarunner.onrender.com

# Client: public project configuration only. Copy to .env.local.
# Without these, local driving and the local challenge remain available.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
