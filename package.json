{
  "name": "serrarunner",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@colyseus/core": "0.16",
    "@colyseus/schema": "3",
    "@colyseus/ws-transport": "0.16",
    "@expo/ui": "~58.0.26",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.119.0",
    "@types/three": "0.162.0",
    "cannon-es": "^0.20.0",
    "colyseus.js": "0.16",
    "expo": "~58.0.22",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.11",
    "expo-constants": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-gl": "~58.0.4",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "three": "0.162.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "setup": "node scripts/setup.cjs",
    "build": "npm run typecheck && npm run server:build && npm run web:build",
    "web:build": "expo export --platform web",
    "audio:generate": "node scripts/generate-engine-audio.cjs",
    "test:audio": "node scripts/check-engine-audio.cjs",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:physics": "node scripts/check-physics.cjs",
    "test:controls": "node scripts/check-controls.cjs",
    "test:interface": "node scripts/check-interface.cjs",
    "test:reconnection": "npm run server:build && node scripts/check-reconnection.cjs",
    "test:challenge": "node scripts/check-challenge.cjs",
    "test:auth": "npm run server:build && node scripts/check-auth.cjs",
    "test:database": "npm run server:build && node scripts/check-database.cjs",
    "test:competition": "npm run server:build && node scripts/check-competition-online.cjs",
    "test:tournament": "npm run server:build && node scripts/check-tournament.cjs",
    "test:tournament:online": "npm run server:build && node scripts/check-tournament-online.cjs",
    "test:prediction": "npm run server:build && node scripts/check-prediction.cjs",
    "test:prediction:online": "npm run server:build && node scripts/check-prediction-online.cjs",
    "test:economy": "npm run server:build && node scripts/check-economy.cjs",
    "test:economy:online": "npm run server:build && node scripts/check-economy-online.cjs",
    "test:garage": "npm run server:build && node scripts/check-garage.cjs && node scripts/check-garage-online.cjs",
    "server:build": "tsc -p server/tsconfig.json",
    "server:start": "node --env-file-if-exists=server/.env.local build-server/server/index.js",
    "server:dev": "npm run server:build && npm run server:start",
    "test:multiplayer": "npm run server:build && node scripts/check-multiplayer.cjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "private": true
}
