{
  "compilerOptions": {
    "target": "ES2020", "module": "commonjs", "moduleResolution": "node",
    "rootDir": "..", "outDir": "../build-server", "strict": true,
    "esModuleInterop": true, "skipLibCheck": true, "types": ["node"],
    "ignoreDeprecations": "6.0"
  },
  "include": ["./**/*.ts", "../src/game/physics.ts", "../src/game/terrain.ts", "../src/game/vehicles.ts", "../src/game/network-types.ts", "../src/game/multiplayer-client.ts"]
}
